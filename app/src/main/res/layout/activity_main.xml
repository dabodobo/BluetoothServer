<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/material_dynamic_neutral60"
    android:backgroundTint="@color/white"
    android:backgroundTintMode="src_atop"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/Text_Details_Server"
        android:layout_width="300dp"
        android:layout_height="20dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="60dp"
        android:text="Details of the BLuetooth Server Adapter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/Btn_Close_Connection"
        android:layout_width="180dp"
        android:layout_height="61dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="@color/material_dynamic_primary70"
        android:text="CLOSE CONNECTION"
        app:icon="@android:drawable/sym_call_missed"
        app:iconPadding="1dp"
        app:iconTint="#E91E63"
        app:iconTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Text_Details_Server" />

    <TextView
        android:id="@+id/Text_Details_Client"
        android:layout_width="142dp"
        android:layout_height="21dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="25dp"
        android:text="Details Client"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Btn_Accept_Connection" />

    <Button
        android:id="@+id/Btn_Accept_Connection"
        android:layout_width="146dp"
        android:layout_height="61dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="25dp"
        android:backgroundTint="@color/material_dynamic_secondary50"
        android:fontFamily="sans-serif-medium"
        android:text="ACCEPT CONNECTION"
        android:textSize="10sp"
        android:typeface="normal"
        app:icon="@android:drawable/stat_sys_data_bluetooth"
        app:iconPadding="4dp"
        app:iconSize="20dp"
        app:iconTint="#00BCD4"
        app:layout_constraintEnd_toStartOf="@+id/Btn_Close_Connection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Text_Details_Server" />

    <Button
        android:id="@+id/Btn_Send"
        android:layout_width="0dp"
        android:layout_height="61dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="71dp"
        android:backgroundTint="@android:color/holo_orange_light"
        android:text="SEND"
        app:icon="@android:drawable/ic_menu_send"
        app:iconPadding="0dp"
        app:iconTint="@color/black"
        app:iconTintMode="multiply"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sendTextEditText" />

    <TextView
        android:id="@+id/recievedEditText"
        android:layout_width="0dp"
        android:layout_height="360dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="20dp"
        android:text="Recieved"
        app:layout_constraintBottom_toTopOf="@+id/Btn_Send"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Text_Details_Client" />

    <EditText
        android:id="@+id/sendTextEditText"
        android:layout_width="205dp"
        android:layout_height="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="71dp"
        android:ems="10"
        android:inputType="text"
        android:text="Type to send"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>